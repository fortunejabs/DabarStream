# Python virtual environments (recreate per machine; never commit)
.venv/
venv/
env/
ENV/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local runtime/test artifacts
*.log
validation_result.txt
bible.db
*.db
*.sqlite
*.sqlite3
*.bible

# Bible translation source files (licensing: keep OUT of git).
# The Bibles/ folder itself is tracked via its README.md only.
Bibles/*
!Bibles/README.md

# Local settings and secrets
.env
.env.*
secrets.json
config.local.*
credentials.json

# Cline/agent snapshot metadata (not project content)
.snapshots/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Shared stream secret; must match DABARSTREAM_KEY on the VPS
stream_key.txt

# Binaries and sensitive key material (never commit)
*.exe
*.key
*.pem
*.out
debug_out.txt